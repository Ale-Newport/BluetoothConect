    "lint": "pnpm -r lint",
    "harness": "node --experimental-strip-types scripts/harness.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^24.3.0"
  }
}

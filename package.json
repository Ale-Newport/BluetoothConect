{
  "name": "airlink-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22.11.0" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",

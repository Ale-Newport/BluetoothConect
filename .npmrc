# A flat node_modules, because Metro cannot walk pnpm's symlink farm.
#
# pnpm's isolated layout is better engineering - a package cannot import
# something it never declared - and it is what this workspace would use if the
# app were not React Native. But Metro's resolver does not follow the symlinks
# pnpm creates in a package's own node_modules, so under isolated linking the
# bundle fails on the first dependency it meets, whichever one that happens to
# be. Hoisting a few packages only moves the failure to the next one.
#
# The strictness is not entirely lost: every package here declares its real
# dependencies, and packages/* are tested under Node with vitest, where a
# missing dependency still fails loudly.
node-linker=hoisted
confirm-modules-purge=false
